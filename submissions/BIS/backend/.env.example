# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
# HyperEVM RPC endpoint
HYPERLIQUID_RPC_URL=https://api.hyperliquid.xyz/evm

# Operator private key (no 0x prefix) - for transaction signing
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Deployed YieldOptimizer vault contract address
VAULT_ADDRESS=0x1234567890123456789012345678901234567890

# ============================================
# GLUEX API CONFIGURATION
# ============================================
# Get your API key from https://portal.gluex.xyz/
GLUEX_API_KEY=E8dDH32WEuTdzU0W32XVA4k8H1R33Fmu

# GlueX API endpoints (default values shown)
GLUEX_YIELD_API_URL=https://yield-api.gluex.xyz
GLUEX_ROUTER_API_URL=https://router.gluex.xyz/v1
GLUEX_EXCHANGE_RATES_URL=https://exchange-rates.gluex.xyz

# ============================================
# OPTIMIZATION PARAMETERS
# ============================================
# Seconds between optimization checks (default: 300 = 5 minutes)
CHECK_INTERVAL=300

# Minimum seconds between rebalances (default: 3600 = 1 hour)
MIN_REBALANCE_INTERVAL=3600

# Maximum number of vaults to allocate to (default: 3)
MAX_ACTIVE_VAULTS=3

# Minimum APY improvement threshold to trigger rebalance (default: 0.5%)
MIN_APY_IMPROVEMENT=0.5

# ============================================
# API SERVER CONFIGURATION
# ============================================
# Port for REST API server (default: 8000)
API_PORT=8000

# Enable CORS for frontend (default: true)
ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API rate limiting (requests per minute)
RATE_LIMIT=60

# Cache TTL in seconds (default: 30)
CACHE_TTL=30

# ============================================
# SUPPORTED BLOCKCHAINS
# ============================================
# Comma-separated list of chain identifiers to support
# Available: ethereum,arbitrum,optimism,polygon,base,bsc,avalanche,gnosis,linea,mantle,scroll,taiko,blast,sonic,hyperevm,unichain,berachain
SUPPORTED_CHAINS=ethereum,arbitrum,base,optimism,polygon,bsc,avalanche

# ============================================
# LOGGING & MONITORING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=

# Enable colored logs (default: true)
COLORED_LOGS=true
