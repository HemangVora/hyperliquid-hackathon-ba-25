# BIS Yield Optimizer - Environment Configuration

# HyperEVM RPC URL
HYPERLIQUID_RPC_URL=https://api.hyperliquid.xyz/evm

# Private key for operator account (no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Deployed YieldOptimizer contract address
VAULT_ADDRESS=0x...

# GlueX API credentials (get from https://portal.gluex.xyz)
GLUEX_API_KEY=your_gluex_api_key_here

# Optional: Custom check interval (seconds)
CHECK_INTERVAL=300

# Optional: Custom minimum rebalance interval (seconds)
MIN_REBALANCE_INTERVAL=3600

