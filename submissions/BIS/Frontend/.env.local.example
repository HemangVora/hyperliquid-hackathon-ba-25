# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Backend API base URL (update for production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Enable API mocking for development (true/false)
NEXT_PUBLIC_USE_MOCK_DATA=false

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Default chain ID
# 1 = Ethereum, 42161 = Arbitrum, 8453 = Base, 10 = Optimism, 137 = Polygon
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# ============================================
# FEATURE FLAGS
# ============================================
# Enable multi-chain support (true/false)
NEXT_PUBLIC_ENABLE_MULTI_CHAIN=true

# Enable real-time updates via WebSocket (true/false)
NEXT_PUBLIC_ENABLE_REALTIME=false

# Data refresh interval in milliseconds (default: 30000 = 30 seconds)
NEXT_PUBLIC_REFRESH_INTERVAL=30000

# Enable debug mode (shows API responses in console)
NEXT_PUBLIC_DEBUG_MODE=false

# ============================================
# UI CONFIGURATION
# ============================================
# App name displayed in header
NEXT_PUBLIC_APP_NAME=BIS Yield Optimizer

# Support email
NEXT_PUBLIC_SUPPORT_EMAIL=support@bis-yield.com

# Maximum pools to display per page
NEXT_PUBLIC_MAX_POOLS_PER_PAGE=50

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=

# Mixpanel Token
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ============================================
# API CONFIGURATION
# ============================================
# API request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

# Number of API retry attempts on failure
NEXT_PUBLIC_API_RETRY_COUNT=3
